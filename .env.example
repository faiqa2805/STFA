# Copy this file to .env and fill in the values you need.
# Every setting is OPTIONAL. Without an API key the agent runs fully offline
# using simple rules instead of an LLM.

# --- LLM (optional) -------------------------------------------------------
# When set, the agent uses Claude to (1) turn your natural-language request
# into a structured setup plan and (2) explain failures in plain language.
# The LLM never runs commands. It can only pick from the registered tools.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Agent workspace ------------------------------------------------------
# Where the agent writes its test C++ project and log file.
# Default: %USERPROFILE%\.cpp-agent
CPP_AGENT_WORKSPACE=

# --- Logging --------------------------------------------------------------
# debug | info | warn | error   (the log file always gets everything >= info)
LOG_LEVEL=info
